// Cloudflare Workers config: the build (python3 build.py) writes the site to dist/, and Workers serves it as static assets only.
// There is no Worker script: a request that matches no file gets dist/404.html with a 404 status
// (not_found_handling "404-page"), so scanner probes never invoke a Worker or count toward the Workers request quota.
{
  "name": "seniorsafetygear",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page"
  }
}
